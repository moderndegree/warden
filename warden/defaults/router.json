    "security": {
      "label": "Security engineer",
      "axis": "coding",
      "desc": "computer security, hacking, malware, or privacy"
    },
    "data": {
      "label": "Data / ML",
      "axis": "reasoning",
      "desc": "data analysis, statistics, databases, machine learning, or AI models"
    },
    "design": {
      "label": "UI / UX designer",
      "axis": "coding",
      "desc": "user interface, web, or visual design"
    },
    "writing": {
      "label": "Writer / editor",
      "axis": "writing",
      "desc": "writing, editing, or communication"
    },
    "research": {
      "label": "Researcher",
      "axis": "knowledge",
      "desc": "general knowledge, current events, science, or research"
    },
    "professional": {
      "label": "Health / legal / money",
      "axis": "knowledge",
      "desc": "health, medicine, law, money, or taxes"
    },
    "home": {
      "label": "Home & devices",
      "axis": "chat",
      "desc": "smart home devices, timers, reminders, music, or personal schedule"
    },
    "conversation": {
      "label": "Conversation",
      "axis": "chat",
      "desc": "casual conversation or emotional support; no specialist"
    }
  },
  "modes": {
    "answer": {
      "label": "Answer",
      "desc": "answer a question, explain something, or chat"
    },
    "make": {
      "label": "Make",
      "desc": "write or edit code or text and hand it back"
    },
    "act": {
      "label": "Act",
      "desc": "carry out actions: run commands, change files in a project, operate apps or devices"
    },
    "plan": {
      "label": "Plan",
      "desc": "plan, design, or decide on an approach before doing the work"
    },
    "lookup": {
      "label": "Look up",
      "desc": "look up current information on the web"
    }
  },
  "complexity": {
    "label": "Complexity",
    "instructions": "How difficult is the task the user is asking for?",
    "levels": [
      "trivial",
      "simple",
      "moderate",
      "hard",
      "very hard"
    ]
  },
  "sensitivity": {
    "label": "Data sensitivity",
    "instructions": "How sensitive or private is the information contained in the user's text?",
    "levels": [
      "public: nothing private",
      "ordinary personal details",
      "private personal information such as health, family, or location",
      "confidential business or legal information",
      "secrets: passwords, API keys, credentials, financial account or ID numbers"
    ],
    "force_local": 3.0,
    "public_max": 1.5
  },
  "_agents_comment": "First agent whose experts AND modes match wins (dict order); otherwise fallback_agent. 'axis' overrides the expert's capability axis. Executors are the harness + model choices; the model is picked by fit within this list. 'via' is how you'd run it.",
