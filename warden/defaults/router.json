  "routing": {
    "_comment": "Within the chosen agent: need = 1 + complexity (0-4 -> 1-5). fit = base - gap_penalty*shortfall - cost_weight*cost - overkill_penalty*surplus + local_bonus (local) + bonus. Secrets/high-risk PII or sensitivity >= force_local keep it local; free tier excluded for any PII/secret, REVIEW, or sensitivity > public_max.",
    "base": 10,
    "gap_penalty": 3,
    "cost_weight": 0.6,
    "overkill_penalty": 0.25,
    "local_bonus": 0.75,
    "chars_per_token": 3.5
  },
  "_availability_comment": "Local checks only (loopback /health, PATH, sign-in files; never a remote or paid API), cached ttl_s. A model's and executor's 'needs' name checks here; an executor whose needs are down is skipped and the route says why. Text that must stay local is held, never sent to the cloud, when no local executor is up.",
  "availability": {
    "ttl_s": 15,
    "checks": {
      "lev": {
        "label": "lev (decision model)",
        "kind": "http",
        "url": "http://127.0.0.1:8200/health"
      },
      "halogen": {
        "label": "Halogen (local model)",
        "kind": "http",
        "url": "http://127.0.0.1:8731/health"
      },
      "grok": {
        "label": "Grok Build",
        "kind": "auth",
        "bin": "grok",
        "file": "~/.grok/auth.json",
        "field": "refresh_token"
      },
      "claude": {
        "label": "Claude Code",
        "kind": "auth",
        "bin": "claude",
        "file": "~/.claude/.credentials.json"
      },
      "opencode": {
        "label": "OpenCode",
        "kind": "bin",
        "bin": "opencode"
      },
      "hermes": {
        "label": "Hermes",
        "kind": "bin",
        "bin": "hermes"
      },
      "openrouter": {
        "label": "OpenRouter (via OpenCode)",
        "kind": "auth",
        "file": "~/.local/share/opencode/auth.json",
        "key": "openrouter"
      }
    }
  }
